{
  "name": "simple-rrule",
  "version": "0.0.0-development",
  "description": "simple rrule string parser and expand date events",
  "author": "Jonas Gedrat",
  "license": "MIT",
  "main": "dist/simple-rrule.umd.js",
  "module": "dist/simple-rrule.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/simple-rrule.es.js",
      "require": "./dist/simple-rrule.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jonasgedrat/simple-rrule.git"
  },
  "bugs": {
    "url": "https://github.com/jonasgedrat/simple-rrule.git/issues"
  },
  "homepage": "https://github.com/jonasgedrat/simple-rrule.git#readme",
  "scripts": {
    "start": "vite build --watch",
    "build": "tsup src/index.ts --dts --sourcemap --target es5",
    "commit": "git-cz",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "prepare": "vite build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "semantic-release": "semantic-release --branches main"
  },
  "peerDependencies": {
    "zod": ">=4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
