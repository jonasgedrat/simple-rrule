{
  "name": "simple-rrule",
  "version": "1.11.0",
  "description": "simple rrule string parser and expand date events",
  "homepage": "https://github.com/jonasgedrat/simple-rrule.git#readme",
  "bugs": {
    "url": "https://github.com/jonasgedrat/simple-rrule.git/issues"
  },
  "license": "MIT",
  "author": "Jonas Gedrat",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonasgedrat/simple-rrule.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/simple-rrule.umd.js",
  "module": "dist/simple-rrule.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/simple-rrule.es.js",
      "require": "./dist/simple-rrule.umd.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "vite build --watch",
    "build": "tsup src/index.ts --dts --sourcemap --target es5",
    "commit": "git-cz",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint-and-typecheck": "oxlint --type-aware && tsc -b --noEmit",
    "format": "oxfmt --write",
    "typecheck": "tsc -b --noEmit",
    "prepare": "vite build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "release:patch": "pnpm version patch && pnpm run build && pnpm publish --provenance --access public && git push --follow-tags",
    "release:minor": "pnpm version minor && pnpm run build && pnpm publish --provenance --access public && git push --follow-tags",
    "release:major": "pnpm version major && pnpm run build && pnpm publish --provenance --access public && git push --follow-tags",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.23.0",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "zod": ">=4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --type-aware --deny-warnings"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
